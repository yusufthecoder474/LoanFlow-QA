{
  "name": "loanflow-qa",
  "version": "1.0.0",
  "description": "Synthetic mortgage workflow and cross-layer QA portfolio",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import node --import tsx server/index.ts",
    "dev:web": "vite",
    "start:api": "node --import tsx server/index.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "vite build",
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:firefox": "playwright test --project=firefox-smoke",
    "test:ui-only": "playwright test --project=chromium tests/ui.spec.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "report": "playwright show-report",
    "agents:init": "playwright init-agents --loop=codex --config=playwright.agent.config.ts",
    "agents:mcp": "playwright-mcp --headless --isolated --allowed-origins http://127.0.0.1:5173",
    "verify:portable": "node --import tsx scripts/portable.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "10.0.1",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
